# ============================================
# TrustLink - Environment Variables
# ============================================

# ---------------- General -------------------
NODE_ENV=development

# ---------------- PostgreSQL ----------------
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=trustlink
DB_PASSWORD=trustlink_secret
DB_DATABASE=trustlink

# ---------------- PgAdmin ------------------
PGADMIN_EMAIL=admin@trustlink.local
PGADMIN_PASSWORD=admin

# ---------------- Redis --------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------------- Backend ------------------
BACKEND_PORT=4000
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRATION=7d
FRONTEND_URL=http://localhost:3000

# ---------------- Email (SMTP) -------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ---------------- Blockchain ---------------
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
CONTRACT_ADDRESS=your_deployed_contract_address
DEPLOYER_PRIVATE_KEY=your_deployer_private_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# ---------------- AI Service ---------------
AI_SERVICE_URL=http://ai-service:8000
AI_MODEL_NAME=all-MiniLM-L6-v2
AI_HOST=0.0.0.0
AI_PORT=8000
AI_LOG_LEVEL=info
AI_CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# ---------------- Frontend -----------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=TrustLink
NEXT_PUBLIC_POLYGON_CHAIN_ID=80002
NEXT_PUBLIC_CONTRACT_ADDRESS=your_deployed_contract_address
